# Dependencies
/vendor
/node_modules
/core/vendor
/core/node_modules

# Environment files
.env
.env.backup
.env.*.local
.env.production
core/.env
core/.env.backup

# Laravel storage & runtime
/core/storage/*.key
/core/storage/debugbar/*
/core/storage/framework/cache/data/*
!/core/storage/framework/cache/data/.gitignore
/core/storage/framework/sessions/*
!/core/storage/framework/sessions/.gitignore
/core/storage/framework/testing/*
!/core/storage/framework/testing/.gitignore
/core/storage/framework/views/*
!/core/storage/framework/views/.gitignore
/core/storage/logs/*
!/core/storage/logs/.gitignore

# Public build artifacts / symlinks
/core/public/hot
/core/public/storage

# Archives, temp files & server logs
*.zip
error_log
check_php.php

# Caches, testing and logs
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
